# One OpenRouter key serves both Jev (Decisions API) and the baseline LLM.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
BASELINE_MODEL=google/gemini-3.1-flash-lite

# Langfuse, self-hosted via docker compose. Keys: localhost:3000 -> project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENABLED=true
